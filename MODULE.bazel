module(
    name = "qubership_apihub_monorepo",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.40.0")
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "aspect_rules_js", version = "2.3.7")
bazel_dep(name = "aspect_rules_ts", version = "3.9.2")
bazel_dep(name = "aspect_bazel_lib", version = "2.19.3")

# Prefer host Go (CI installs 1.26.5 via setup-go). Download is a fallback.
# rules_go >=0.56 compiles cmd/pack from source — required because Go 1.25+
# no longer ships pack.exe in the SDK zip.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.host(version = "1.26.5")
go_sdk.download(version = "1.26.5")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")
use_repo(go_deps, "com_github_asaiyusuke_jsonpath_v2", "com_github_buraksezer_olric", "com_github_buraksezer_olric_cloud_plugin", "com_github_coreos_go_oidc_v3", "com_github_crewjam_saml", "com_github_go_ldap_ldap", "com_github_go_pg_pg_v10", "com_github_go_playground_validator_v10", "com_github_google_uuid", "com_github_gorilla_handlers", "com_github_gorilla_mux", "com_github_gosimple_slug", "com_github_iancoleman_orderedmap", "com_github_invopop_jsonschema", "com_github_mark3labs_mcp_go", "com_github_minio_minio_go_v7", "com_github_mitchellh_mapstructure", "com_github_openai_openai_go_v3", "com_github_pkg_errors", "com_github_prometheus_client_golang", "com_github_robfig_cron_v3", "com_github_russellhaering_goxmldsig", "com_github_shaj13_go_guardian_v2", "com_github_shaj13_libcache", "com_github_sirupsen_logrus", "com_github_spf13_viper", "com_github_stretchr_testify", "com_github_x_cray_logrus_prefixed_formatter", "com_github_xuri_excelize_v2", "com_github_zeebo_xxh3", "in_gopkg_natefinch_lumberjack_v2", "in_gopkg_resty_v1", "in_gopkg_square_go_jose_v2", "in_gopkg_yaml_v3", "org_golang_x_crypto", "org_golang_x_net", "org_golang_x_oauth2", "org_golang_x_sync", "org_golang_x_time")

# npm is a root-module dev dependency so Go-only CI can use --ignore_dev_dependency
# and skip fetching private @netcracker packages from GHCR npm.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "qubership_core_base",
    digest = "sha256:b917b3a1731a2ae26b507d22565f030ec25ff8d28b75a80b8b08bbc946f4d73b",
    image = "ghcr.io/netcracker/qubership-core-base",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
use_repo(
    oci,
    "qubership_core_base",
    "qubership_core_base_linux_amd64",
    "qubership_core_base_linux_arm64",
)
