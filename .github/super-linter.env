# File will be loaded as environment variables
# It must contain strings like:
# name=value

GITLEAKS_LOG_LEVEL=warn
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JAVASCRIPT_STANDARD=false
VALIDATE_JSCPD=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_KUBERNETES_KUBECONFORM=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_YAML_PRETTIER=false

# TODO: fix python files and enable the check again
VALIDATE_PYTHON_BLACK=false
VALIDATE_PYTHON_FLAKE8=false
VALIDATE_PYTHON_ISORT=false
VALIDATE_PYTHON_MYPY=false
VALIDATE_PYTHON_PYINK=false
VALIDATE_PYTHON_PYLINT=false

# APIHUB CUSTOM (monorepo union of former per-module overrides)

# netcracker/.github ships markdownlint as `.markdownlint.json`, but super-linter's
# default MARKDOWN_CONFIG_FILE is `.markdown-lint.yml`.
MARKDOWN_CONFIG_FILE=.markdownlint.json

# Excludes for editorconfig-checker; file MUST be under .github/linters/
EDITORCONFIG_FILE_NAME=.editorconfig-checker.json

# APM agent content + monorepo fixtures that must not fail generic linters
FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)docs/pages/erd(/|$)|(build_docker_image\.cmd|build_golang_binary\.cmd)|qubership-apihub-api-processor/test/projects/broken/
MARKDOWN_FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)docs/pages/erd(/|$)
NATURAL_LANGUAGE_FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)docs/pages/erd(/|$)

# Go linter has a bug and doesn't work fine
VALIDATE_GO=false
VALIDATE_GO_MODULES=false

# Another tool used in APIHUB for typescript linting
VALIDATE_CSS_PRETTIER=false
VALIDATE_HTML_PRETTIER=false
VALIDATE_JAVASCRIPT_ES=false
VALIDATE_JSON=false
VALIDATE_JSONC=false
VALIDATE_JSONC_PRETTIER=false
VALIDATE_TSX=false
VALIDATE_TYPESCRIPT_ES=false
VALIDATE_TYPESCRIPT_PRETTIER=false
VALIDATE_TYPESCRIPT_STANDARD=false

# Disable more strange checks
VALIDATE_BASH_EXEC=false
VALIDATE_SHELL_SHFMT=false

# Sandbox / fixtures: Checkov hangs or floods on OpenAPI across the monorepo
VALIDATE_CHECKOV=false

# Intentionally invalid / incomplete OpenAPI fixtures in api-diff and api-processor
VALIDATE_OPENAPI=false

# GraphQL fixtures kept as-is for api-processor tests
VALIDATE_GRAPHQL_PRETTIER=false
