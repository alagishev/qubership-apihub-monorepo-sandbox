load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

pkg_tar(
    name = "binary_tar",
    srcs = ["//qubership-api-linter-service/qubership-api-linter-service:qubership-api-linter-service"],
    mode = "0555",
    package_dir = "/app/qubership-api-linter-service",
)

pkg_tar(
    name = "resources_tar",
    srcs = glob(["qubership-api-linter-service/resources/**"]),
    mode = "0555",
    package_dir = "/app/qubership-api-linter-service/resources",
    strip_prefix = "qubership-api-linter-service/resources",
)

pkg_tar(
    name = "spectral_tar",
    srcs = glob(["qubership-api-linter-service/resources/spectral/**"]),
    mode = "0555",
    package_dir = "/app/qubership-api-linter-service/resources/spectral",
    strip_prefix = "qubership-api-linter-service/resources/spectral",
)

oci_image(
    name = "image",
    base = "@qubership_core_base",
    tars = [
        ":binary_tar",
        ":resources_tar",
    ],
    workdir = "/app/qubership-api-linter-service",
    entrypoint = ["/app/qubership-api-linter-service/qubership-api-linter-service"],
    user = "10001:10001",
)

oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/netcracker/qubership-api-linter-service",
)
