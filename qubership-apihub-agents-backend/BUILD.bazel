load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

pkg_tar(
    name = "binary_tar",
    srcs = ["//qubership-apihub-agents-backend/qubership-apihub-agents-backend:qubership-apihub-agents-backend"],
    mode = "0555",
    package_dir = "/app/qubership-apihub-agents-backend",
)

pkg_tar(
    name = "resources_tar",
    srcs = glob(["qubership-apihub-agents-backend/resources/**"]),
    mode = "0555",
    package_dir = "/app/qubership-apihub-agents-backend/resources",
    strip_prefix = "qubership-apihub-agents-backend/resources",
)

oci_image(
    name = "image",
    base = "@qubership_core_base",
    tars = [
        ":binary_tar",
        ":resources_tar",
    ],
    workdir = "/app/qubership-apihub-agents-backend",
    entrypoint = ["/app/qubership-apihub-agents-backend/qubership-apihub-agents-backend"],
    user = "10001:10001",
)

oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/netcracker/qubership-apihub-agents-backend",
)
