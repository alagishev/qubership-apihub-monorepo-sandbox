# npm service image is built/pushed via Dockerfile.local (see tools/ci/docker_push_npm.sh).
# Keep a small Bazel target so detect/modules_to_targets path globs stay valid.

package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    "Dockerfile.local",
])

sh_test(
    name = "dockerfile_present",
    size = "small",
    srcs = ["ci_image_contract_test.sh"],
    data = [
        "Dockerfile.local",
        "package.json",
    ],
)
