common --enable_bzlmod
common --incompatible_enable_cc_toolchain_resolution

# Go: no cgo (matches our Docker builds).
common --@rules_go//go/config:pure

# Go-only builds skip root-module npm/rules_ts (dev_dependency).
build:go-only --ignore_dev_dependency
test:go-only --ignore_dev_dependency

# CI profile (activate with --config=ci)
build:ci --jobs=auto
build:ci --remote_download_minimal
test:ci --test_output=errors
test:ci --test_summary=short

# Release builds
build:release --stamp
build:release --workspace_status_command=tools/ci/workspace_status.sh

# Optional local overrides (not committed). On Windows with a space in the
# user profile path, add e.g.:
#   startup --output_user_root=C:/tmp/bazel-out
try-import %workspace%/.bazelrc.user
